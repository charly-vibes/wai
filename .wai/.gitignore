# Local-only files
*.local
*.cache
# Active pipeline run pointers (like .git/HEAD — written by `wai pipeline start`,
# cleared by `wai close` when the run completes). Runtime-only, not committed.
.pipeline-run
.last-run
# Spawn wrapper checkpoints and logs (ticket wai-tdnv): process-lifetime state
# (pids, live logs) written by `wai pipeline spawn*`. Ephemeral — never commit.
pipeline-runs/spawns/
